  ];
  function renderLawArticles(filter){
    const box = document.getElementById('lawResults');
    const f = (filter||'').trim().toLowerCase();
    const list = f ? lawArticles.filter(a => a.text.toLowerCase().includes(f) || a.num.includes(f) || (a.chap||'').toLowerCase().includes(f)) : lawArticles;
    if(list.length===0){ box.innerHTML = '<div class="noresults">ما فيه مادة تطابق «'+filter+'» في هذا المرجع.</div>'; return; }
    let lastChap = null;
    let html = '<div style="font-size:.78rem;color:var(--ink-soft);margin-bottom:10px;">'+list.length+' مادة'+(f?' مطابقة':(' من أصل '+lawArticles.length))+'</div>';
    list.forEach(a=>{
      if(a.chap !== lastChap){ html += '<h3 style="font-size:.85rem;color:var(--gold);margin:18px 0 8px;">'+a.chap+'</h3>'; lastChap = a.chap; }
      html += '<div class="art" style="margin:0 0 10px;"><b style="color:var(--pine-deep);">المادة ('+a.num+')</b> — '+a.text+'</div>';
    });
    box.innerHTML = html;
  }
  document.getElementById('lawSearch').addEventListener('input', e => renderLawArticles(e.target.value));

  function renderSevere(){
    document.getElementById('severeList').innerHTML = severePenalties.map((s,i)=>
      '<li><span class="num">'+(i+1)+'</span><span><b>'+s.name+'</b><br><span style="color:var(--ink-soft);">'+s.outcome+'</span></span></li>'
    ).join('');
  }

  // ---------- init ----------
  calcOvertime(); calcEOS(); calcLeaveEntitlement(); calcNitaqat(); calcProfession();
  renderPenaltyTable(); renderViolationSelect(); calcPenalty(); renderSevere(); renderLawArticles('');

  // ---------- البحث الشامل ----------
  const KB = [
    {q:'حساب الأوفر تايم / العمل الإضافي', a:'أجر الساعة الإضافية = أجر الساعة العادية + 50% منه (150% إجمالاً)، وفق المادة 107.', tab:'overtime'},
    {q:'الحد الأقصى لساعات العمل الإضافي', a:'720 ساعة سنوياً كحد أقصى إلا بموافقة العامل، وفق المادة 22 من اللائحة التنفيذية.', tab:'overtime'},
    {q:'مكافأة نهاية الخدمة عند الفصل', a:'نصف شهر عن كل سنة من أول 5 سنوات، وشهر كامل عن كل سنة تالية — المادة 84.', tab:'eos'},
    {q:'مكافأة نهاية الخدمة عند الاستقالة', a:'لا شيء قبل سنتين، ثُلث من 2-5 سنوات، ثُلثين من 5-10 سنوات، وكاملة بعد 10 سنوات — المادة 85.', tab:'eos'},
    {q:'راتب الإجازة السنوية', a:'21 يوماً كحد أدنى، تصبح 30 يوماً بعد 5 سنوات خدمة متصلة — المادة 109.', tab:'leave'},
    {q:'توطين مهن المبيعات والتسويق', a:'60% نسبة توطين لمهن التسويق والمبيعات، على منشآت 3 عاملين فأكثر بهذه المهن.', tab:'professions'},
    {q:'توطين المحاسبة أو المشتريات أو غيرها', a:'قاعدة قرارات المهن في توسّع — أرسلي مصدر القرار الرسمي وسنضيفه موثّقاً.', tab:'professions'},
    {q:'قرارات توطين المهن الهندسية', a:'46 مهنة هندسية مستهدفة، مع اشتراط الاعتماد المهني من الهيئة السعودية للمهندسين.', tab:'professions'},
    {q:'نطاقات التوطين ونسبة السعودة', a:'احتساب النسبة الحالية والفجوة حتى النسبة المطلوبة وعدد الموظفين اللازم إضافتهم.', tab:'nitaqat'},
    {q:'جزاء التأخير أو الغياب', a:'يُدخَل نوع المخالفة وعدد مرات التكرار، ومحرك الجزاءات يحسب الجزاء المطبَّق تلقائياً من اللائحة.', tab:'penalties'},
    {q:'قواعد توقيع الجزاءات التأديبية', a:'لا جزاء بدون لائحة معتمدة، ولا بدون سماع أقوال الموظف، ولا أكثر من جزاء عن مخالفة واحدة.', tab:'penalties'},
  ];
  const searchInput = document.getElementById('globalSearch');
  const resultsBox = document.getElementById('searchResults');
  const allPanels = document.getElementById('allPanels');
  searchInput.addEventListener('input', ()=>{
    const term = searchInput.value.trim();
    if(term.length < 2){ resultsBox.classList.remove('active'); allPanels.style.display='block'; return; }
    const matches = KB.filter(item => (item.q+item.a).toLowerCase().includes(term.toLowerCase()));
    allPanels.style.display='none'; resultsBox.classList.add('active');
    if(matches.length===0){ resultsBox.innerHTML = '<div class="noresults">ما لقيت نتائج مطابقة لـ«'+term+'».</div>'; return; }
    resultsBox.innerHTML = matches.map(m => '<div class="sresult" data-tab="'+m.tab+'"><div class="q">'+m.q+'</div><div class="a">'+m.a+'</div><div class="go">اذهب إلى القسم ←</div></div>').join('');
    resultsBox.querySelectorAll('.sresult').forEach(el=> el.addEventListener('click', ()=> showTab(el.dataset.tab)));
  });
</script>
