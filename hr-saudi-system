    document.getElementById('pResultOut').textContent = row.p[occ] || row.p[row.p.length-1] || '—';
    const labels = ['المرة الأولى','المرة الثانية','المرة الثالثة','المرة الرابعة فأكثر'];
    document.getElementById('pResultSub').textContent = labels[occ];
  }
  document.getElementById('addRowBtn').addEventListener('click',()=>{
    penalties.push({name:'مخالفة جديدة', p:['إنذار كتابي','خصم يوم','خصم يومين','إيقاف بدون أجر']});
    savePenalties(penalties); renderPenaltyTable(); renderViolationSelect(); calcPenalty();
  });
  document.getElementById('pViolation').addEventListener('change',calcPenalty);
  document.getElementById('pOccur').addEventListener('change',calcPenalty);

  // ---------- قرارات توطين المهن ----------
  function calcProfession(){
    const required = parseFloat(document.getElementById('profSelect').value) || 0;
    const total = parseFloat(document.getElementById('profTotal').value) || 0;
    const saudi = parseFloat(document.getElementById('profSaudi').value) || 0;
    const current = total>0 ? (saudi/total*100) : 0;
    const box = document.getElementById('profResult');
    if(current >= required){
      box.textContent = 'ممتاز — نسبتكم الحالية ' + current.toLocaleString('ar-SA',{maximumFractionDigits:1}) + '% تحقق أو تتجاوز المطلوب (' + required + '%).';
    } else {
      const req = required/100;
      const x = (req*total - saudi) / (1-req);
      box.textContent = 'نسبتكم الحالية ' + current.toLocaleString('ar-SA',{maximumFractionDigits:1}) + '% — تحتاجين لإضافة حوالي ' + Math.ceil(x) + ' موظف سعودي بهذي المهنة للوصول لـ' + required + '%.';
    }
  }
  document.querySelectorAll('#profSelect, #profTotal, #profSaudi').forEach(el=>el.addEventListener('input',calcProfession));

  document.getElementById('profSearchBtn').addEventListener('click', ()=>{
    const q = document.getElementById('profSearchInput').value.trim();
    if(!q) return;
    window.open('https://www.google.com/search?q=' + encodeURIComponent('site:hrsd.gov.sa توطين مهنة ' + q), '_blank', 'noopener');
  });

  // ---------- نظام العمل — مرجع سريع ----------
  const lawArticles = [
    {num:'1', chap:'التعريفات والأحكام العامة', text:'يُسمى هذا النظام "نظام العمل".'},
    {num:'2', chap:'التعريفات والأحكام العامة', text:'تعريفات أساسية: الوزارة، الوزير، مكتب العمل، صاحب العمل، العامل، الحدث (15-18 سنة)، العمل الأصلي، العمل المؤقت، العمل العرضي، العمل الموسمي، العمل لبعض الوقت، الخدمة المستمرة، الإسناد، الاستقالة، الأجر الأساسي، الأجر الفعلي، المنشأة، الشهر (30 يوماً).'},
    {num:'3', chap:'التعريفات والأحكام العامة', text:'العمل حق للمواطن، والمواطنون متساوون في حق العمل دون تمييز على أساس الجنس أو الإعاقة أو السن أو أي شكل من أشكال التمييز.'},
    {num:'4', chap:'التعريفات والأحكام العامة', text:'يجب مراعاة أحكام الشريعة الإسلامية عند تطبيق أحكام النظام.'},
    {num:'5', chap:'التعريفات والأحكام العامة', text:'نطاق سريان النظام: كل عقد عمل، عمال الحكومة بالزراعة/الرعي، عمال المؤسسات الخيرية، عقود التأهيل والتدريب، العمال لبعض الوقت.'},
    {num:'6', chap:'التعريفات والأحكام العامة', text:'تسري على العامل المؤقت والعرضي والموسمي وبعض الوقت أحكام خاصة بالواجبات والتأديب وساعات العمل والراحة والإجازات والعمل الإضافي والسلامة والتعويض.'},
    {num:'7', chap:'التعريفات والأحكام العامة', text:'استثناءات من تطبيق النظام: أفراد أسرة صاحب العمل، لاعبو ومدربو الأندية الرياضية، العمالة المنزلية، عمال الزراعة والرعي الخاصون، غير السعوديين القادمين لمهمة محددة لا تزيد شهرين.'},
    {num:'8', chap:'التعريفات والأحكام العامة', text:'يبطل كل شرط يخالف أحكام النظام، ويبطل كل إبراء أو مصالحة عن حقوق العامل الناشئة أثناء سريان العقد ما لم تكن أكثر فائدة له.'},
    {num:'9', chap:'التعريفات والأحكام العامة', text:'اللغة العربية واجبة الاستعمال في البيانات والسجلات والملفات وعقود العمل؛ وإذا استُعملت لغة أجنبية إلى جانبها فالنص العربي هو المعتمد.'},
    {num:'10', chap:'التعريفات والأحكام العامة', text:'تُحسب جميع المدد والمواعيد المنصوص عليها في النظام بالتقويم الهجري ما لم يُنص على خلاف ذلك.'},
    {num:'11', chap:'التعريفات والأحكام العامة', text:'إذا عهد صاحب العمل لشخص آخر بعمل من أعماله الأصلية، وجب أن يعطي هذا الأخير لعماله نفس حقوق ومزايا عمال صاحب العمل الأصلي.'},
    {num:'12', chap:'التعريفات والأحكام العامة', text:'تضع الوزارة نموذجاً موحداً للائحة تنظيم العمل، وتضع الوزارة ضوابط اعتماد لوائح تنظيم العمل.'},
    {num:'13', chap:'التعريفات والأحكام العامة', text:'يلتزم كل صاحب عمل بإعداد لائحة تنظيم عمل وفق النموذج المعتمد من الوزارة، ويجب إعلانها في مكان ظاهر بالمنشأة.'},
    {num:'15', chap:'التعريفات والأحكام العامة', text:'على صاحب العمل عند بدء العمل في أي منشأة إبلاغ مكتب العمل المختص كتابة ببيانات المنشأة ونشاطها وعدد عمالها.'},
    {num:'16', chap:'التعريفات والأحكام العامة', text:'إذا لم يتمكن صاحب العمل من ممارسة العمل بنفسه، يعين مسؤولاً يمثله في مكان العمل ويكون مسؤولاً عن أي مخالفة.'},
    {num:'17', chap:'التعريفات والأحكام العامة', text:'على صاحب العمل الاحتفاظ في مكان العمل بالسجلات والملفات، ووضع جدول بمواعيد العمل وفترات الراحة ويوم الراحة الأسبوعي.'},
    {num:'18', chap:'التعريفات والأحكام العامة', text:'انتقال ملكية المنشأة لا يُنهي عقود العمل النافذة، وتُعد الخدمة مستمرة، مع تضامن الخلف والسلف بالحقوق السابقة.'},
    {num:'19', chap:'التعريفات والأحكام العامة', text:'المبالغ المستحقة للعامل أو ورثته تُعد ديوناً ممتازة من الدرجة الأولى على أموال صاحب العمل.'},
    {num:'20', chap:'التعريفات والأحكام العامة', text:'حظر إساءة استعمال أحكام النظام من صاحب العمل أو العامل للضغط على حرية الطرف الآخر أو أطراف أخرى.'},
    {num:'22', chap:'تنظيم عمليات التوظيف', text:'توفر الوزارة قنوات توظيف دون مقابل لمساعدة العمال وأصحاب الأعمال، وجمع بيانات سوق العمل.'},
    {num:'23', chap:'تنظيم عمليات التوظيف', text:'لكل مواطن قادر على العمل وراغب فيه حق تسجيل اسمه في قنوات التوظيف.'},
    {num:'25', chap:'تنظيم عمليات التوظيف', text:'التزامات صاحب العمل بإرسال بيانات للوزارة: الأعمال الشاغرة، نتيجة التوظيف، بيانات العمال، تقرير سنوي عن حالة العمل.'},
    {num:'26', chap:'تنظيم عمليات التوظيف', text:'التزام المنشآت باستقطاب السعوديين وتوظيفهم وتدريبهم؛ ويجب ألا تقل نسبة العمالة السعودية عن 75% من إجمالي العمال إلا لعدم توافر الكفاءات، بقرار من الوزير.'},
    {num:'28', chap:'توظيف ذوي الإعاقة', text:'كل صاحب عمل يستخدم 25 عاملاً فأكثر ملزم بتشغيل 4% على الأقل من ذوي الإعاقة المؤهلين مهنياً من إجمالي عماله.'},
    {num:'29', chap:'توظيف ذوي الإعاقة', text:'إذا أصيب عامل بإصابة عمل نتج عنها نقص في قدراته، يُلزَم صاحب العمل بتوظيفه في عمل مناسب بنفس الأجر المحدد لذلك العمل.'},
    {num:'30', chap:'شركات ومكاتب التوظيف', text:'لا يجوز ممارسة نشاط توظيف السعوديين أو الاستقدام أو الإسناد إلا بترخيص من الوزارة.'},
    {num:'31', chap:'شركات ومكاتب التوظيف', text:'العمال الذين وظفتهم مكاتب أو شركات التوظيف يُعدون عمالاً لدى صاحب العمل مباشرة، ترتبط بهم علاقة عقدية مباشرة.'},
    {num:'32', chap:'توظيف غير السعوديين', text:'لا يجوز الاستقدام بقصد العمل إلا بعد موافقة الوزارة.'},
    {num:'33', chap:'توظيف غير السعوديين', text:'لا يجوز لغير السعودي ممارسة عمل إلا بعد الحصول على رخصة عمل، وتشترط لمنحها: دخول مشروع، توافر الكفاءة المطلوبة، والتعاقد مع صاحب عمل.'},
    {num:'34', chap:'توظيف غير السعوديين', text:'رخصة العمل لا تغني عنها أي تصريح آخر مطلوب من جهة أخرى لممارسة العمل أو المهنة.'},
    {num:'35', chap:'توظيف غير السعوديين', text:'للوزارة الامتناع عن تجديد رخصة عمل غير السعودي متى خالف صاحب العمل معايير التوطين.'},
    {num:'36', chap:'توظيف غير السعوديين', text:'للوزير بقرار منه تحديد المهن والأعمال التي يُحظر على غير السعودي الاشتغال بها.'},
    {num:'37', chap:'توظيف غير السعوديين', text:'يجب أن يكون عقد عمل غير السعودي مكتوباً ومحدد المدة؛ فإن خلا من بيان مدته تُعد مدته سنة من تاريخ المباشرة، ويتجدد لمدة مماثلة إن استمر العمل.'},
    {num:'38', chap:'توظيف غير السعوديين', text:'لا يجوز لصاحب العمل تشغيل العامل في مهنة غير المهنة المدونة في رخصة عمله، ويحظر على العامل الاشتغال في غير مهنته.'},
    {num:'39', chap:'توظيف غير السعوديين', text:'حظر ترك صاحب العمل عامله يعمل لدى الغير أو لحسابه الخاص، وحظر عمل العامل لدى صاحب عمل آخر أو لحسابه الخاص دون إجراءات نظامية.'},
    {num:'40', chap:'توظيف غير السعوديين', text:'يتحمل صاحب العمل رسوم الاستقدام والإقامة ورسوم تغيير المهنة، وتذكرة عودة العامل لموطنه، وتجهيز جثمانه ونقله عند الوفاة.'},
    {num:'42', chap:'التدريب والتأهيل', text:'على كل صاحب عمل وضع سياسة لتدريب عماله السعوديين وتأهيلهم لرفع مهاراتهم في الأعمال الفنية والإدارية والمهنية.'},
    {num:'43', chap:'التدريب والتأهيل', text:'يجب على صاحب العمل أن يؤهل أو يدرب من عماله السعوديين نسبة يحددها الوزير بقرار منه.'},
    {num:'45', chap:'التدريب والتأهيل', text:'عقد التأهيل أو التدريب: عقد يلتزم صاحب العمل بموجبه بتأهيل أو تدريب شخص لإعداده في مهنة معينة.'},
    {num:'46', chap:'التدريب والتأهيل', text:'يجب أن يكون عقد التأهيل أو التدريب مكتوباً، محدداً المهنة ومدة التدريب ومراحله والمكافأة.'},
    {num:'48', chap:'التدريب والتأهيل', text:'لصاحب العمل إنهاء عقد التدريب أو التأهيل إذا ثبتت عدم قابلية أو قدرة المتدرب، وللمتدرب حق إنهاء العقد بإشعار أسبوع مسبق دون حق أي طرف في التعويض.'},
    {num:'50', chap:'عقد العمل', text:'عقد العمل: عقد مبرم بين صاحب عمل وعامل، يتعهد بموجبه العامل بالعمل تحت إدارة صاحب العمل أو إشرافه لقاء أجر.'},
    {num:'51', chap:'عقد العمل', text:'يُكتب عقد العمل من نسختين، ويُعد العقد قائماً ولو كان غير مكتوب؛ وفي هذه الحالة يجوز للعامل وحده إثبات العقد بجميع طرق الإثبات.'},
    {num:'52', chap:'عقد العمل', text:'تضع الوزارة نموذجاً موحداً لعقد العمل يتضمن: اسم الطرفين ومكانهما، الأجر، نوع العمل ومكانه، تاريخ الالتحاق، مدة العقد إن وجدت، والحقوق والالتزامات الأساسية.'},
    {num:'53', chap:'عقد العمل', text:'فترة التجربة تُذكر صراحة في العقد بمدة واضحة، على ألا يزيد مجموعها في جميع الأحوال على 180 يوماً.'},
    {num:'54', chap:'عقد العمل', text:'لا يجوز إخضاع العامل للتجربة أكثر من مرة لدى صاحب عمل واحد، إلا باتفاق كتابي على تجربة لمهنة أو عمل آخر.'},
    {num:'55', chap:'عقد العمل', text:'العقد محدد المدة يتجدد لمدة غير محددة إذا استمر الطرفان في تنفيذه بعد انتهاء مدته؛ ويتحول لغير محدد المدة إذا تكرر التجديد 3 مرات متتالية أو بلغت مدته مع التجديد 4 سنوات.'},
    {num:'56', chap:'عقد العمل', text:'في جميع حالات التجديد لمدة محددة، تُعد مدة التجديد امتداداً للمدة الأصلية في حساب حقوق العامل ومدة الخدمة.'},
    {num:'57', chap:'عقد العمل', text:'العقد المبرم لأجل عمل معين ينتهي بإنجاز العمل المتفق عليه.'},
    {num:'58', chap:'عقد العمل', text:'لا يجوز نقل العامل من مكان عمله الأصلي لمكان آخر يقتضي تغيير محل إقامته دون موافقته الكتابية، إلا لظروف طارئة ولمدة لا تتجاوز 30 يوماً في السنة، مع تحمل صاحب العمل تكاليف النقل.'},
    {num:'59', chap:'عقد العمل', text:'لا يجوز نقل العامل ذي الأجر الشهري إلى فئة العمال اليوميين أو المعينين بالأسبوع أو القطعة أو الساعة إلا بموافقته الكتابية.'},
    {num:'60', chap:'عقد العمل', text:'لا يجوز تكليف العامل بعمل يختلف اختلافاً جوهرياً عن العمل المتفق عليه دون موافقته الكتابية، إلا لظروف طارئة ولمدة لا تتجاوز 30 يوماً في السنة.'},
    {num:'61', chap:'واجبات أصحاب العمل', text:'يجب على صاحب العمل: الامتناع عن تشغيل العامل سخرة، عدم حجز أجره دون سند قضائي، معاملته باحترام، إتاحة الوقت لممارسة حقوقه دون تنزيل من أجره، تسهيل مهام الجهات المختصة، عدم التمييز، توفير السكن أو بدل، وتوفير المواصلات أو بدل.'},
    {num:'62', chap:'واجبات أصحاب العمل', text:'إذا حضر العامل لأداء عمله ولم يُمنَع إلا لسبب راجع لصاحب العمل، فله الحق في أجر المدة التي لم يؤدِّ فيها العمل.'},
    {num:'63', chap:'واجبات أصحاب العمل', text:'على صاحب العمل أو من يمثله منع دخول أي مادة محرمة شرعاً لأماكن العمل، وتطبيق العقوبات النظامية على من يحوزها أو يتعاطاها.'},
    {num:'64', chap:'واجبات أصحاب العمل', text:'عند انتهاء عقد العمل، يجب على صاحب العمل إعطاء العامل شهادة خدمة دون مقابل توضح تاريخ الالتحاق والانتهاء والمهنة والأجر الأخير، دون الإساءة لسمعته، وإعادة ما أودعه من وثائق.'},
    {num:'65', chap:'واجبات العمال', text:'يجب على العامل: إنجاز العمل وفق الأصول والتعليمات المشروعة، العناية بالآلات والأدوات، الالتزام بحسن السلوك، تقديم العون في الكوارث، الخضوع للفحص الطبي عند الطلب، وحفظ الأسرار الفنية والتجارية والصناعية.'},
    {num:'66', chap:'قواعد التأديب', text:'الجزاءات التأديبية التي يجوز لصاحب العمل توقيعها على العامل: الإنذار، الغرامة، الحرمان من العلاوة أو تأجيلها حتى سنة، تأجيل الترقية حتى سنة، الإيقاف عن العمل مع الحرمان من الأجر، الفصل من العمل في الحالات المقررة.'},
    {num:'67', chap:'قواعد التأديب', text:'لا يجوز لصاحب العمل توقيع جزاء غير وارد في هذا النظام أو في لائحة تنظيم العمل.'},
    {num:'68', chap:'قواعد التأديب', text:'لا يجوز تشديد الجزاء في حالة تكرار المخالفة إذا كان قد انقضى على المخالفة السابقة 180 يوماً من تاريخ إبلاغ العامل بتوقيع الجزاء عنها.'},
    {num:'69', chap:'قواعد التأديب', text:'لا يجوز اتهام العامل بمخالفة مضى على كشفها أكثر من 30 يوماً، ولا توقيع جزاء تأديبي بعد أكثر من 30 يوماً من تاريخ ثبوتها في حقه.'},
    {num:'70', chap:'قواعد التأديب', text:'لا يجوز توقيع جزاء على أمر ارتكبه العامل خارج مكان العمل إلا إذا اتصل بالعمل أو بصاحبه، ولا يجوز أن تزيد الغرامة عن الواحدة على أجر 5 أيام، ولا توقيع أكثر من جزاء واحد على المخالفة الواحدة، ولا اقتطاع أكثر من أجر 5 أيام شهرياً وفاء للغرامات، ولا إيقاف العامل أكثر من 5 أيام في الشهر.'},
    {num:'71', chap:'قواعد التأديب', text:'لا يجوز توقيع جزاء تأديبي إلا بعد إبلاغ العامل كتابة بالمخالفة وسماع أقواله وتحقيق دفاعه، وتوثيق ذلك في محضر يودع في ملفه.'},
    {num:'72', chap:'قواعد التأديب', text:'يجب إبلاغ العامل كتابة بقرار توقيع الجزاء، وله التظلم كتابة للجهة المختصة لدى صاحب العمل خلال 30 يوماً، ثم الاعتراض أمام المحاكم العمالية خلال 30 يوماً من رفض التظلم أو انتهاء مدة البت فيه.'},
    {num:'73', chap:'قواعد التأديب', text:'يجب على صاحب العمل قيد الغرامات الموقعة على العامل في سجل خاص، ولا يجوز التصرف فيها إلا بما يعود بالنفع على عمال المنشأة، بموافقة اللجنة العمالية أو الوزارة عند عدم وجودها.'},
    {num:'74', chap:'انتهاء عقد العمل', text:'حالات انتهاء عقد العمل: اتفاق الطرفين كتابة، انتهاء المدة المحددة، إرادة أحد الطرفين في العقد غير محدد المدة، الاستقالة، بلوغ سن التقاعد، القوة القاهرة، إغلاق المنشأة نهائياً، إنهاء النشاط، إجراءات الإفلاس، وحالات أخرى ينص عليها نظام آخر.'},
    {num:'75', chap:'انتهاء عقد العمل', text:'في العقد غير محدد المدة، يجوز لأي طرف إنهاءه بسبب مشروع بإشعار مسبق: 30 يوماً من العامل و60 يوماً من صاحب العمل إذا كان الأجر يُدفع شهرياً، أو 30 يوماً من الطرفين في غير ذلك.'},
    {num:'76', chap:'انتهاء عقد العمل', text:'إذا لم يراعِ الطرف الذي أنهى العقد مهلة الإشعار، التزم بأن يدفع للطرف الآخر مبلغاً مساوياً لأجره عن مهلة الإشعار.'},
    {num:'77', chap:'انتهاء عقد العمل', text:'عند الإنهاء لسبب غير مشروع، يستحق الطرف المتضرر تعويضاً قدره أجر 15 يوماً عن كل سنة خدمة (للعقد غير محدد المدة) أو أجر المدة الباقية (للعقد محدد المدة)، بحد أدنى أجر شهرين.'},
    {num:'78', chap:'انتهاء عقد العمل', text:'إذا كان الإشعار من جانب صاحب العمل، يحق للعامل التغيب يوماً كاملاً أو 8 ساعات في الأسبوع أثناء مهلة الإشعار للبحث عن عمل آخر مع استحقاق أجر ذلك اليوم.'},
    {num:'79', chap:'انتهاء عقد العمل', text:'لا ينقضي عقد العمل بوفاة صاحب العمل ما لم تكن شخصيته قد رُوعيت عند التعاقد، لكنه ينقضي بوفاة العامل أو عجزه عن أداء عمله بشهادة طبية معتمدة.'},
    {num:'79 مكرر', chap:'انتهاء عقد العمل', text:'يُعد طلب الاستقالة مقبولاً تلقائياً بعد مضي 30 يوماً دون رد من صاحب العمل، وله تأجيل القبول لمدة لا تزيد على 60 يوماً بإيضاح مسبب، وللعامل العدول عن طلبه خلال 7 أيام ما لم يُقبل قبل ذلك.'},
    {num:'80', chap:'انتهاء عقد العمل', text:'حالات جواز فصل العامل دون مكافأة أو إشعار أو تعويض: الاعتداء على صاحب العمل أو المدير أو الرؤساء، عدم أداء الالتزامات الجوهرية رغم الإنذار الكتابي، السلوك المخل بالشرف أو الأمانة، الإضرار المتعمد بصاحب العمل، التزوير، أثناء فترة التجربة، الغياب دون عذر أكثر من 30 يوماً متقطعاً أو 15 يوماً متصلاً بعد الإنذار، استغلال المنصب الوظيفي بطريقة غير مشروعة، وإفشاء الأسرار الصناعية أو التجارية.'},
    {num:'81', chap:'انتهاء عقد العمل', text:'يحق للعامل ترك العمل دون إشعار مع احتفاظه بكامل حقوقه النظامية في حالات: عدم وفاء صاحب العمل بالتزاماته الجوهرية، الغش وقت التعاقد، التكليف بعمل مختلف جوهرياً دون رضاه، الاعتداء أو سوء المعاملة، الخطر الجسيم في مكان العمل مع علم صاحب العمل وعدم إزالته، وإجبار العامل ظاهرياً على إنهاء العقد.'},
    {num:'82', chap:'انتهاء عقد العمل', text:'لا يجوز لصاحب العمل إنهاء خدمة العامل بسبب المرض قبل استنفاد المدد المحددة لإجازته المرضية.'},
    {num:'83', chap:'انتهاء عقد العمل', text:'يجوز لصاحب العمل اشتراط عدم منافسة العامل له بعد انتهاء العقد لحماية مصالحه المشروعة، بشرط أن يكون الشرط محدداً بالزمان والمكان ونوع العمل، وألا تزيد مدته على سنتين.'},
    {num:'84', chap:'مكافأة نهاية الخدمة', text:'عند انتهاء علاقة العمل، يدفع صاحب العمل للعامل مكافأة: نصف أجر شهر عن كل سنة من السنوات الخمس الأولى، وأجر شهر كامل عن كل سنة تالية، وتُحسب كسور السنة بنسبتها، ويُتخذ الأجر الأخير أساساً للحساب.'},
    {num:'85', chap:'مكافأة نهاية الخدمة', text:'إذا انتهت العلاقة باستقالة العامل: لا استحقاق قبل سنتين متصلتين، ثلث المكافأة من سنتين إلى أقل من 5 سنوات، ثلثاها من 5 إلى أقل من 10 سنوات، وكاملة إذا بلغت 10 سنوات فأكثر.'},
    {num:'86', chap:'مكافأة نهاية الخدمة', text:'يجوز الاتفاق على ألا تُحسب ضمن الأجر الذي تُسوّى على أساسه مكافأة نهاية الخدمة مبالغ العمولات أو النسب المئوية من ثمن المبيعات ونحوها من عناصر الأجر القابلة بطبيعتها للزيادة والنقصان.'},
    {num:'87', chap:'مكافأة نهاية الخدمة', text:'تُستحق المكافأة كاملة إذا ترك العامل العمل نتيجة قوة قاهرة خارجة عن إرادته، وكذلك للعاملة إذا أنهت عقدها خلال 6 أشهر من تاريخ زواجها أو 3 أشهر من تاريخ وضعها.'},
    {num:'88', chap:'مكافأة نهاية الخدمة', text:'عند انتهاء الخدمة، على صاحب العمل تصفية حقوق العامل خلال أسبوع (إن كان الإنهاء من صاحب العمل) أو أسبوعين (إن كان الإنهاء من العامل) من تاريخ انتهاء العلاقة.'},
    {num:'89', chap:'الأجور', text:'لمجلس الوزراء عند الاقتضاء، بناءً على اقتراح الوزير، وضع حد أدنى للأجور.'},
    {num:'90', chap:'الأجور', text:'يجب دفع الأجر بالعملة الرسمية وفي مواعيده: أسبوعياً للعمال اليوميين، شهرياً لأصحاب الأجر الشهري، وتُلزَم المنشآت بدفع الأجور عبر البنوك المعتمدة (حماية الأجور).'},
    {num:'91', chap:'الأجور', text:'إذا تسبب العامل بخطئه في فقد أو إتلاف ممتلكات صاحب العمل، جاز اقتطاع المبلغ اللازم للإصلاح من أجره، على ألا يزيد المقتطع شهرياً عن أجر 5 أيام، مع حق العامل في التظلم.'},
    {num:'92', chap:'الأجور', text:'لا يجوز الخصم من أجر العامل دون موافقته الكتابية إلا في حالات: استرداد القروض، اشتراكات التأمينات الاجتماعية، اشتراكات صندوق الادخار، أقساط مشاريع الإسكان، والغرامات التأديبية.'},
    {num:'93', chap:'الأجور', text:'لا يجوز في جميع الأحوال أن تزيد نسبة المبالغ المحسومة على نصف أجر العامل المستحق، إلا بإثبات إمكانية الزيادة أو حاجة العامل لأكثر من نصف أجره.'},
    {num:'94', chap:'الأجور', text:'عند تأخر صاحب العمل عن أداء الأجر في موعده دون مسوغ مشروع، للعامل أو من يمثله التقدم للمحكمة العمالية لإلزامه برد ما حُسم دون وجه حق أو دفع الأجور المتأخرة.'},
    {num:'98', chap:'ساعات العمل', text:'لا يجوز تشغيل العامل فعلياً أكثر من 8 ساعات في اليوم أو 48 ساعة في الأسبوع، وتُخفَّض ساعات العمل في رمضان للمسلمين إلى 6 ساعات يومياً (36 أسبوعياً).'},
    {num:'99', chap:'ساعات العمل', text:'يجوز زيادة ساعات العمل إلى 9 ساعات يومياً لبعض فئات العمال أو الصناعات غير المستمرة، ويجوز تخفيضها إلى 7 ساعات للأعمال الخطرة أو الضارة.'},
    {num:'100', chap:'ساعات العمل', text:'يجوز لصاحب العمل بموافقة الوزارة، في المنشآت التي تقتضي طبيعة عملها العمل بالتناوب، زيادة ساعات العمل حتى 8 يومياً/48 أسبوعياً بشرط ألا يزيد المتوسط عند احتسابه لمدة 3 أسابيع أو أقل على ذلك.'},
    {num:'101', chap:'فترات الراحة', text:'لا يجوز تشغيل العامل أكثر من 5 ساعات متصلة دون فترة راحة لا تقل عن نصف ساعة، ولا يبقى العامل في مكان العمل أكثر من 12 ساعة في اليوم.'},
    {num:'102', chap:'فترات الراحة', text:'فترات الراحة والصلاة والطعام لا تدخل ضمن ساعات العمل الفعلية، ولا يكون العامل خلالها تحت سلطة صاحب العمل.'},
    {num:'104', chap:'الراحة الأسبوعية', text:'يوم الجمعة هو يوم الراحة الأسبوعية بأجر كامل لجميع العمال، ويجوز لصاحب العمل استبداله بيوم آخر بعد إبلاغ مكتب العمل، ولا يجوز تعويضه بمقابل نقدي.'},
    {num:'105', chap:'الراحة الأسبوعية', text:'استثناءً في الأماكن البعيدة عن العمران، يجوز تجميع أيام الراحة الأسبوعية عن مدة لا تتجاوز 8 أسابيع باتفاق الطرفين وموافقة الوزارة.'},
    {num:'106', chap:'الراحة الأسبوعية', text:'استثناءات لعدم التقيد بساعات العمل والراحة الأسبوعية (الجرد السنوي، منع الحوادث، المواسم) بحد أقصى 30 يوماً سنوياً، وبحد أقصى 10 ساعات عمل فعلي يومياً أو 60 أسبوعياً.'},
    {num:'107', chap:'العمل الإضافي', text:'يجب على صاحب العمل أن يدفع للعامل أجراً إضافياً عن ساعات العمل الإضافية يوازي أجر الساعة مضافاً إليه 50% من الأجر الأساسي (150% إجمالاً)، ويجوز الاتفاق على إجازة تعويضية مدفوعة الأجر بدلاً من ذلك. تُعد جميع ساعات العمل في أيام العطل والأعياد ساعات إضافية.'},
    {num:'108', chap:'ساعات العمل', text:'لا تسري أحكام ساعات العمل الاعتيادية على: أصحاب المناصب العليا ذات السلطة الإشرافية، الأعمال التحضيرية أو التكميلية، العمل المتقطع بالضرورة، وعمال الحراسة والنظافة (عدا الحراسة الأمنية المدنية).'},
    {num:'109', chap:'الإجازات', text:'يستحق العامل عن كل عام إجازة سنوية لا تقل عن 21 يوماً، تُزاد إلى 30 يوماً إذا أمضى 5 سنوات متصلة لدى صاحب العمل نفسه، وتكون بأجر يُدفع مقدماً.'},
    {num:'110', chap:'الإجازات', text:'يجوز للعامل بموافقة صاحب العمل تأجيل إجازته السنوية أو أيام منها للسنة التالية، ولصاحب العمل تأجيلها بعد نهاية سنة الاستحقاق لمدة لا تزيد على 90 يوماً لمقتضيات العمل، وبموافقة العامل الكتابية إن استمر التأجيل.'},
    {num:'111', chap:'الإجازات', text:'للعامل الحق في أجر أيام الإجازة المستحقة إذا ترك العمل قبل استعمالها، بنسبة ما قضاه من السنة في العمل.'},
    {num:'112', chap:'الإجازات', text:'لكل عامل الحق في إجازة بأجر كامل في الأعياد والمناسبات التي تحددها اللائحة.'},
    {num:'113', chap:'الإجازات', text:'للعامل الحق في إجازة بأجر كامل: 5 أيام عند الزواج أو وفاة أحد أصوله أو فروعه، 3 أيام عند وفاة الأخ أو الأخت، و3 أيام عند ولادة مولود له خلال 7 أيام من تاريخ الولادة.'},
    {num:'114', chap:'الإجازات', text:'للعامل الحق في إجازة بأجر لا تقل عن 10 أيام ولا تزيد على 15 يوماً لأداء فريضة الحج مرة واحدة طوال مدة الخدمة، بشرط أن يكون قد أمضى لدى صاحب العمل سنتين متصلتين على الأقل.'},
    {num:'115', chap:'الإجازات', text:'للعامل المنتسب لمؤسسة تعليمية بموافقة صاحب العمل الحق في إجازة بأجر كامل لأداء الامتحان غير المعاد بعدد أيام الامتحان الفعلية، أما الامتحان المعاد فبإجازة دون أجر.'},
    {num:'116', chap:'الإجازات', text:'يجوز للعامل بموافقة صاحب العمل الحصول على إجازة دون أجر يتفق الطرفان على مدتها، ويُعد عقد العمل موقوفاً خلال المدة الزائدة على 20 يوماً ما لم يتفق الطرفان على خلاف ذلك.'},
    {num:'117', chap:'الإجازات', text:'للعامل الذي يثبت مرضه إجازة مرضية بأجر كامل عن الثلاثين يوماً الأولى، وبثلاثة أرباع الأجر عن الستين التالية، ودون أجر عن الثلاثين التي تليها، خلال السنة المرضية الواحدة.'},
    {num:'118', chap:'الإجازات', text:'لا يجوز للعامل أثناء تمتعه بأي من إجازاته أن يعمل لدى صاحب عمل آخر، وإلا جاز حرمانه من أجر تلك الإجازة أو استرداده.'},
    {num:'119', chap:'العمل لبعض الوقت', text:'لا يُعد العمال الذين يتأثرون بتخفيض جماعي مؤقت لساعات عملهم لأسباب اقتصادية أو تقنية أو هيكلية عمالاً لبعض الوقت.'},
    {num:'120', chap:'العمل لبعض الوقت', text:'يُصدر الوزير القواعد والضوابط اللازمة لتنظيم العمل لبعض الوقت، وتسري أحكام النظام في حدود ما يقرره الوزير، مع حماية موازية للعمال المتفرغين من ناحية السلامة والصحة المهنية وإصابات العمل.'},
    {num:'121', chap:'الوقاية من مخاطر العمل', text:'على صاحب العمل حفظ حالة صحية ونظيفة بالمنشأة، وتأمين إنارتها ومياهها الصالحة للشرب وقواعد الحماية والسلامة والصحة المهنية.'},
    {num:'122', chap:'الوقاية من مخاطر العمل', text:'على صاحب العمل اتخاذ الاحتياطات اللازمة لحماية العمال من الأخطار والأمراض الناجمة عن العمل، وإعلان تعليمات السلامة في مكان ظاهر بالعربية وأي لغة أخرى عند الاقتضاء دون تحميل العمال أي تكلفة.'},
    {num:'123', chap:'الوقاية من مخاطر العمل', text:'على صاحب العمل إحاطة العامل قبل مزاولة عمله بمخاطر مهنته، وتوفير أدوات الوقاية الشخصية وتدريب العمال على استخدامها.'},
    {num:'124', chap:'الوقاية من مخاطر العمل', text:'على العامل استعمال وسائل الوقاية المخصصة، والمحافظة عليها، وتنفيذ تعليمات السلامة، والامتناع عن أي تصرف يعطل تنفيذها أو يسيء استخدام وسائل الحماية.'},
    {num:'125', chap:'الوقاية من مخاطر العمل', text:'على صاحب العمل اتخاذ الاحتياطات اللازمة للوقاية من الحريق وتأمين منافذ النجاة وتعليق تعليمات مفصلة بشأن وسائل منع الحريق.'},
    {num:'133', chap:'إصابات العمل', text:'إذا أُصيب العامل بإصابة عمل أو مرض مهني، التزم صاحب العمل بعلاجه وتحمّل جميع نفقات العلاج المباشرة وغير المباشرة (إقامة، فحوصات، أشعة، أجهزة تعويضية، نقل).'},
    {num:'134', chap:'إصابات العمل', text:'تُعد الإصابة "إصابة عمل" وفق ما هو منصوص عليه في نظام التأمينات الاجتماعية، وتُعد الأمراض المهنية في حكم إصابات العمل.'},
    {num:'137', chap:'إصابات العمل', text:'يستحق المصاب بعجز مؤقت عن العمل ناتج عن إصابة عمل معونة مالية تعادل أجره كاملاً لمدة 60 يوماً، ثم 75% من أجره طوال مدة العلاج؛ فإن بلغت مدة العلاج سنة أو تقرر طبياً عدم احتمال شفائه، عُدت الإصابة عجزاً كلياً وأُنهي العقد وعُوّض عن الإصابة.'},
    {num:'138', chap:'إصابات العمل', text:'إذا نتج عن الإصابة عجز دائم كلي أو وفاة، يُقدَّر التعويض بما يعادل أجر 3 سنوات بحد أدنى 54,000 ريال؛ وفي العجز الدائم الجزئي يستحق المصاب تعويضاً بنسبة العجز المقدرة وفق جدول دليل نسب العجز.'},
    {num:'142', chap:'الخدمات الصحية والاجتماعية', text:'على كل صاحب عمل إعداد خزانة أو أكثر للإسعافات الطبية الأولية، مزودة بالأدوية ووسائل الإسعاف اللازمة.'},
    {num:'143', chap:'الخدمات الصحية والاجتماعية', text:'على صاحب العمل إجراء فحص دوري لعماله المعرضين لأمراض مهنية مرة كل سنة على الأقل، وإثبات نتيجة الفحص في سجلاته وملفات العمال.'},
    {num:'149', chap:'تشغيل النساء', text:'للمرأة العاملة الحق في إجازة وضع بأجر كامل لمدة 12 أسبوعاً، منها 6 أسابيع وجوبية تالية للوضع، ولها توزيع الباقي كما تراه ابتداءً من 4 أسابيع قبل التاريخ المرجح للوضع.'},
