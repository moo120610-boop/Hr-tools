  function calcOvertime(){
    const basic = parseFloat(document.getElementById('basic').value) || 0;
    const hours = parseFloat(document.getElementById('hours').value) || 0;
    const daysmonth = parseFloat(document.getElementById('daysmonth').value) || 30;
    const dailyhours = parseFloat(document.getElementById('dailyhours').value) || 8;
    const rate = parseFloat(document.getElementById('rate').value) || 150;
    const hourly = basic / daysmonth / dailyhours;
    const ohourly = hourly * (rate/100);
    const total = ohourly * hours;
    document.getElementById('hourlyOut').textContent = fmt(hourly) + ' ريال';
    document.getElementById('ohourlyOut').textContent = fmt(ohourly) + ' ريال';
    document.getElementById('hoursOut').textContent = hours.toLocaleString('ar-SA');
    document.getElementById('rateOut').textContent = rate;
    document.getElementById('totalOut').textContent = fmt(total);
    document.getElementById('capWarn').style.display = (hours*12 > 720) ? 'block' : 'none';
  }
