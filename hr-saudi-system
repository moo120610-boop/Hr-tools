<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Tooling Standard for HR Professionals</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700;900&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#122622; --ink-soft:#3c534d; --paper:#F6F3EC; --paper-raised:#FFFFFF;
    --line:#D9D2C2; --pine:#16413A; --pine-deep:#0D2B26; --gold:#A9822C; --gold-soft:#E7D9B0;
    --danger:#8C3B2E; --radius:4px;
    padding-top: env(safe-area-inset-top, 0px); padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
      --ink:#EDE8DA; --ink-soft:#B9B2A0; --paper:#10201C; --paper-raised:#152F29;
      --line:#2A423B; --pine:#3E8C77; --pine-deep:#1B4A40; --gold:#D8B85B; --gold-soft:#3A331E;
    }
  }
  :root[data-theme="dark"]{
    --ink:#EDE8DA; --ink-soft:#B9B2A0; --paper:#10201C; --paper-raised:#152F29;
    --line:#2A423B; --pine:#3E8C77; --pine-deep:#1B4A40; --gold:#D8B85B; --gold-soft:#3A331E;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;background:var(--paper);color:var(--ink);}
  body{font-family:'Tajawal',system-ui,sans-serif;font-weight:400;line-height:1.65;-webkit-font-smoothing:antialiased;}
  a{color:var(--pine);}
  .wrap{max-width:980px;margin:0 auto;padding:0 20px;}

  header.top{border-bottom:1px solid var(--line);padding:20px 0 0;background:var(--paper);position:sticky;top:0;z-index:20;}
  .brandrow{display:flex;align-items:center;justify-content:space-between;gap:16px;padding-bottom:14px;flex-wrap:wrap;}
  .brand{display:flex;align-items:baseline;gap:10px;}
  .brand .mark{font-weight:900;font-size:1.4rem;color:var(--pine);letter-spacing:0.5px;}
  .brand .sub{font-size:.8rem;color:var(--ink-soft);font-weight:400;}
  .searchbox{position:relative;flex:1;min-width:180px;max-width:320px;}
  .searchbox input{width:100%;padding:9px 38px 9px 12px;border:1px solid var(--line);border-radius:100px;background:var(--paper-raised);color:var(--ink);font-family:inherit;font-size:.85rem;}
  .searchbox input:focus{outline:2px solid var(--pine);outline-offset:1px;}
  .searchbox .ic{position:absolute;left:14px;top:50%;transform:translateY(-50%);color:var(--ink-soft);font-size:.85rem;pointer-events:none;}

  nav.tabs{display:flex;gap:2px;overflow-x:auto;scrollbar-width:none;}
  nav.tabs::-webkit-scrollbar{display:none;}
  .tab{padding:11px 14px;font-size:.87rem;white-space:nowrap;color:var(--ink-soft);border-bottom:2px solid transparent;cursor:pointer;font-weight:500;}
  .tab.active{color:var(--pine);border-bottom-color:var(--gold);font-weight:700;}

  main{padding:30px 0 70px;}
  section.panel{display:none;}
  section.panel.active{display:block;}

  h1.hero{font-size:clamp(1.35rem,3vw,1.9rem);font-weight:900;color:var(--pine-deep);margin:0 0 8px;line-height:1.35;}
  p.lede{color:var(--ink-soft);font-size:.96rem;max-width:66ch;margin:0 0 26px;}

  .grid{display:grid;grid-template-columns:1.15fr 1fr;gap:20px;align-items:start;}
  @media (max-width:760px){.grid{grid-template-columns:1fr;}}

  .card{background:var(--paper-raised);border:1px solid var(--line);border-radius:var(--radius);padding:22px;}
  .card h2{font-size:1rem;margin:0 0 16px;color:var(--pine-deep);font-weight:700;}

  .field{margin-bottom:15px;}
  .field label{display:block;font-size:.82rem;color:var(--ink-soft);margin-bottom:6px;}
  .field .hint{font-size:.71rem;color:var(--ink-soft);opacity:.8;margin-top:4px;}
  .inputrow{position:relative;}
  input[type=number],input[type=text]{
    width:100%;padding:10px 13px;border:1px solid var(--line);border-radius:var(--radius);
    background:var(--paper);color:var(--ink);font-family:inherit;font-size:.95rem;-moz-appearance:textfield;
  }
  input[type=number]{padding-left:44px;}
  input:focus,select:focus{outline:2px solid var(--pine);outline-offset:1px;border-color:var(--pine);}
  input[type=number]::-webkit-outer-spin-button,input[type=number]::-webkit-inner-spin-button{margin:0;}
  .unit{position:absolute;left:12px;top:50%;transform:translateY(-50%);font-size:.75rem;color:var(--ink-soft);pointer-events:none;}
  select{width:100%;padding:10px 13px;border:1px solid var(--line);border-radius:var(--radius);background:var(--paper);color:var(--ink);font-family:inherit;font-size:.9rem;}

  .three{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;}
  .twocol{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
  @media (max-width:480px){.three{grid-template-columns:1fr 1fr 1fr;}.twocol{grid-template-columns:1fr;}}

  details.adv{margin-top:6px;border-top:1px solid var(--line);padding-top:14px;}
  details.adv summary{cursor:pointer;font-size:.85rem;color:var(--pine);font-weight:500;list-style:none;}
  details.adv summary::-webkit-details-marker{display:none;}
  details.adv summary:before{content:"▸ ";}
  details.adv[open] summary:before{content:"▾ ";}
  details.adv .field{margin-top:16px;}

  .result{background:var(--pine-deep);color:#F3EFE2;border-radius:var(--radius);padding:22px;position:sticky;top:90px;}
  .result h2{font-size:.86rem;font-weight:500;color:#BFD6CC;margin:0 0 4px;}
  .result .big{font-size:clamp(1.8rem,4.4vw,2.4rem);font-weight:900;color:var(--gold-soft);margin:4px 0 2px;direction:ltr;text-align:right;font-variant-numeric:tabular-nums;}
  .result .bigunit{font-size:.9rem;color:#BFD6CC;font-weight:400;}
  .breakdown{margin-top:16px;border-top:1px solid rgba(255,255,255,.15);padding-top:14px;}
  .brow{display:flex;justify-content:space-between;font-size:.83rem;padding:6px 0;color:#D9E5DF;}
  .brow span:last-child{font-variant-numeric:tabular-nums;color:#F3EFE2;font-weight:500;}
  .warn{margin-top:14px;font-size:.76rem;color:#E7D9B0;background:rgba(169,130,44,.15);border:1px solid rgba(169,130,44,.35);padding:10px 12px;border-radius:var(--radius);}
  .good{margin-top:14px;font-size:.76rem;color:#CFE8DC;background:rgba(62,140,119,.18);border:1px solid rgba(62,140,119,.4);padding:10px 12px;border-radius:var(--radius);}

  .legal{margin-top:26px;}
  .legal h3{font-size:.88rem;color:var(--pine-deep);margin:0 0 8px;}
  .legal p{font-size:.83rem;color:var(--ink-soft);margin:0 0 10px;}
  .legal .art{border-right:3px solid var(--gold);padding:4px 16px;margin:12px 0;font-size:.86rem;color:var(--ink);background:var(--paper-raised);border-radius:0 var(--radius) var(--radius) 0;}

  .rulelist{list-style:none;margin:0;padding:0;}
  .rulelist li{padding:12px 0;border-bottom:1px solid var(--line);font-size:.87rem;display:flex;gap:12px;}
  .rulelist li:last-child{border-bottom:none;}
  .rulelist .num{color:var(--gold);font-weight:900;flex:0 0 auto;}

  .stepbar{display:flex;justify-content:space-between;font-size:.7rem;color:var(--ink-soft);margin:10px 0 6px;}
  .barwrap{height:8px;background:var(--line);border-radius:100px;overflow:hidden;}
  .barfill{height:100%;background:var(--gold);border-radius:100px;transition:width .25s;}

  .searchresults{display:none;}
  .searchresults.active{display:block;}
  .sresult{background:var(--paper-raised);border:1px solid var(--line);border-radius:var(--radius);padding:16px 18px;margin-bottom:12px;cursor:pointer;}
  .sresult:hover{border-color:var(--pine);}
  .sresult .q{font-weight:700;color:var(--pine-deep);font-size:.9rem;margin-bottom:5px;}
  .sresult .a{font-size:.83rem;color:var(--ink-soft);}
  .sresult .go{font-size:.71rem;color:var(--gold);margin-top:6px;}
  .noresults{color:var(--ink-soft);font-size:.87rem;padding:20px 0;}

  /* decision cards */
  .deccard{background:var(--paper-raised);border:1px solid var(--line);border-radius:var(--radius);padding:20px 22px;margin-bottom:16px;}
  .deccard .top{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;flex-wrap:wrap;margin-bottom:10px;}
  .deccard h3{margin:0;font-size:1.02rem;color:var(--pine-deep);}
  .decpct{background:var(--gold-soft);color:var(--gold);font-weight:900;font-size:.95rem;padding:4px 14px;border-radius:100px;white-space:nowrap;}
  .decpct.tbd{background:var(--line);color:var(--ink-soft);font-size:.75rem;font-weight:700;}
  .chips{display:flex;flex-wrap:wrap;gap:6px;margin:10px 0;}
  .chip{background:var(--paper);border:1px solid var(--line);border-radius:100px;padding:4px 12px;font-size:.76rem;color:var(--ink-soft);}
  .decmeta{font-size:.78rem;color:var(--ink-soft);display:flex;gap:16px;flex-wrap:wrap;margin-top:10px;}
  .decmeta a{color:var(--pine);font-weight:600;}

  /* penalty engine */
  .ptable{width:100%;border-collapse:collapse;font-size:.84rem;margin-top:6px;}
  .ptable th{text-align:right;color:var(--ink-soft);font-weight:500;padding:8px 6px;border-bottom:1px solid var(--line);font-size:.76rem;}
  .ptable td{padding:8px 6px;border-bottom:1px solid var(--line);}
  .ptable input{padding:6px 8px;font-size:.82rem;}
  .miniBtn{background:none;border:1px solid var(--line);border-radius:var(--radius);padding:6px 10px;font-size:.78rem;color:var(--ink-soft);cursor:pointer;font-family:inherit;}
  .miniBtn:hover{border-color:var(--pine);color:var(--pine);}
  .primaryBtn{background:var(--pine);color:#fff;border:none;border-radius:var(--radius);padding:10px 18px;font-size:.86rem;cursor:pointer;font-family:inherit;font-weight:700;}
  .primaryBtn:hover{background:var(--pine-deep);}
  .delBtn{background:none;border:none;color:var(--danger);cursor:pointer;font-size:.9rem;}

  .comingsoon{text-align:center;padding:60px 20px;color:var(--ink-soft);}
  .comingsoon .icon{font-size:2.2rem;margin-bottom:14px;}
  .comingsoon h2{color:var(--pine-deep);font-size:1.15rem;margin:0 0 8px;}

  footer{border-top:1px solid var(--line);padding:22px 0 40px;color:var(--ink-soft);font-size:.78rem;text-align:center;}
</style>
</head>
<body>

<header class="top">
  <div class="wrap">
    <div class="brandrow">
      <div class="brand"><span class="mark">مِعيار</span><span class="sub">أدوات مرجعية لمختصي الموارد البشرية</span></div>
      <div class="searchbox"><input type="text" id="globalSearch" placeholder="ابحث: نهاية الخدمة، توطين المحاسبة، تأخير…"><span class="ic">🔍</span></div>
    </div>
    <nav class="tabs" id="tabs">
      <div class="tab active" data-tab="overtime">الأوفر تايم</div>
      <div class="tab" data-tab="eos">نهاية الخدمة</div>
      <div class="tab" data-tab="leave">راتب الإجازة</div>
      <div class="tab" data-tab="professions">قرارات توطين المهن</div>
      <div class="tab" data-tab="nitaqat">فجوة النطاق</div>
      <div class="tab" data-tab="penalties">الجزاءات</div>
      <div class="tab" data-tab="lawref">نظام العمل</div>
    </nav>
  </div>
</header>

<main class="wrap">
  <div class="searchresults" id="searchResults"></div>
  <div id="allPanels">

  <!-- ===== الأوفر تايم ===== -->
  <section class="panel active" id="panel-overtime">
    <h1 class="hero">حاسبة الأجر الإضافي (الأوفر تايم)</h1>
    <p class="lede">احتساب مستحقات ساعات العمل الإضافية وفق المادة (107) من نظام العمل السعودي.</p>
    <div class="grid">
      <div class="card">
        <h2>بيانات الموظف</h2>
        <div class="field"><label for="basic">الراتب الأساسي الشهري</label>
          <div class="inputrow"><input type="number" id="basic" value="6000" min="0" step="50"><span class="unit">ريال</span></div></div>
        <div class="field"><label for="hours">عدد ساعات العمل الإضافي</label>
          <div class="inputrow"><input type="number" id="hours" value="10" min="0" step="0.5"><span class="unit">ساعة</span></div>
          <div class="hint">للفترة التي تريدين احتسابها</div></div>
        <details class="adv"><summary>إعدادات متقدمة</summary>
          <div class="twocol">
            <div class="field"><label for="daysmonth">أيام الشهر المعتمدة</label>
              <div class="inputrow"><input type="number" id="daysmonth" value="30" min="28" max="31"><span class="unit">يوم</span></div></div>
            <div class="field"><label for="dailyhours">ساعات العمل اليومية</label>
              <div class="inputrow"><input type="number" id="dailyhours" value="8" min="1" max="12"><span class="unit">ساعة</span></div></div>
          </div>
          <div class="field"><label for="rate">نسبة الأجر الإضافي</label>
            <div class="inputrow"><input type="number" id="rate" value="150" min="100" step="5"><span class="unit">%</span></div>
            <div class="hint">النظام يحدد 150% كحد أدنى.</div></div>
        </details>
      </div>
      <div class="result">
        <h2>إجمالي المستحق</h2>
        <div class="big"><span id="totalOut">375.00</span></div>
        <div class="bigunit">ريال سعودي</div>
        <div class="breakdown">
          <div class="brow"><span>أجر الساعة العادية</span><span id="hourlyOut">25.00 ريال</span></div>
          <div class="brow"><span>أجر الساعة الإضافية (<span id="rateOut">150</span>%)</span><span id="ohourlyOut">37.50 ريال</span></div>
          <div class="brow"><span>عدد الساعات</span><span id="hoursOut">10</span></div>
        </div>
        <div class="warn" id="capWarn" style="display:none;">النظام يحدد حداً أقصى 720 ساعة سنوياً (المادة 22 من اللائحة التنفيذية) إلا بموافقة العامل.</div>
      </div>
    </div>
    <div class="legal"><h3>السند النظامي</h3>
      <div class="art">المادة (107): «يدفع صاحب العمل للعامل أجراً إضافياً عن ساعات العمل الإضافية يوازي أجر الساعة مضافاً إليه (50%) من أجره الأساسي.»</div>
    </div>
  </section>

  <!-- ===== نهاية الخدمة ===== -->
  <section class="panel" id="panel-eos">
    <h1 class="hero">حاسبة مكافأة نهاية الخدمة</h1>
    <p class="lede">وفق المادتين (84) و(85)، بدقة على مستوى السنوات والأشهر والأيام.</p>
    <div class="grid">
      <div class="card">
        <h2>بيانات الموظف</h2>
        <div class="field"><label for="eosWage">الأجر الشامل الأخير (شهري)</label>
          <div class="inputrow"><input type="number" id="eosWage" value="8000" min="0" step="50"><span class="unit">ريال</span></div>
          <div class="hint">الأساسي + جميع البدلات النظامية الثابتة</div></div>
        <div class="field"><label>مدة الخدمة</label>
          <div class="three">
            <div class="inputrow"><input type="number" id="eosY" value="6" min="0" step="1" style="padding-left:13px;text-align:center;"></div>
            <div class="inputrow"><input type="number" id="eosM" value="0" min="0" max="11" step="1" style="padding-left:13px;text-align:center;"></div>
            <div class="inputrow"><input type="number" id="eosD" value="0" min="0" max="30" step="1" style="padding-left:13px;text-align:center;"></div>
          </div>
          <div class="stepbar"><span>سنوات</span><span>أشهر</span><span>أيام</span></div>
        </div>
        <div class="field"><label for="eosType">سبب انتهاء علاقة العمل</label>
          <select id="eosType">
            <option value="employer">إنهاء من صاحب العمل / انتهاء مدة العقد (المادة 84)</option>
            <option value="resign">استقالة العامل (المادة 85)</option>
          </select>
        </div>
      </div>
      <div class="result">
        <h2>مكافأة نهاية الخدمة المستحقة</h2>
        <div class="big"><span id="eosTotalOut">30000.00</span></div>
        <div class="bigunit">ريال سعودي</div>
        <div class="breakdown">
          <div class="brow"><span>مدة الخدمة الفعلية</span><span id="eosYearsOut">6.00 سنة</span></div>
          <div class="brow"><span>المكافأة الكاملة (المادة 84)</span><span id="eosBaseOut">40000.00 ريال</span></div>
          <div class="brow"><span>نسبة الاستحقاق المطبّقة</span><span id="eosPctOut">100%</span></div>
        </div>
        <div class="good" id="eosNote" style="display:none;"></div>
      </div>
    </div>
    <div class="legal"><h3>السند النظامي</h3>
      <div class="art">المادة (84): نصف أجر شهر عن كل سنة من السنوات الخمس الأولى، وأجر شهر كامل عن كل سنة تالية، وتُحسب كسور السنة بنسبة ما قضاه منها.</div>
      <div class="art">المادة (85) عند الاستقالة: لا استحقاق قبل سنتين، ثُلث المكافأة من سنتين إلى أقل من 5 سنوات، ثُلثاها من 5 إلى أقل من 10 سنوات، وكاملة بعد 10 سنوات فأكثر.</div>
      <p>لا تشمل هذه الحاسبة حالات الحرمان (المادة 80) ولا استثناءات المرأة العاملة (المادة 87).</p>
    </div>
  </section>

  <!-- ===== راتب الإجازة ===== -->
  <section class="panel" id="panel-leave">
    <h1 class="hero">حاسبة راتب الإجازة السنوية</h1>
    <p class="lede">وفق المادة (109): 21 يوماً كحد أدنى، وتصبح 30 يوماً بعد 5 سنوات خدمة متصلة لدى نفس صاحب العمل.</p>
    <div class="grid">
      <div class="card">
        <h2>بيانات الموظف</h2>
        <div class="field"><label for="leaveWage">الأجر الشامل الشهري</label>
          <div class="inputrow"><input type="number" id="leaveWage" value="7000" min="0" step="50"><span class="unit">ريال</span></div></div>
        <div class="field"><label for="leaveYears">سنوات الخدمة المتصلة</label>
          <div class="inputrow"><input type="number" id="leaveYears" value="3" min="0" step="0.5"><span class="unit">سنة</span></div>
          <div class="hint">تحدد استحقاق 21 أو 30 يوماً تلقائياً</div></div>
        <div class="field"><label for="leaveDays">عدد أيام الإجازة المطلوب احتسابها</label>
          <div class="inputrow"><input type="number" id="leaveDays" value="21" min="0" step="1"><span class="unit">يوم</span></div>
          <div class="hint">يتحدث تلقائياً حسب سنوات الخدمة، ويمكن تعديله لحالة جزئية</div></div>
      </div>
      <div class="result">
        <h2>راتب الإجازة المستحق</h2>
        <div class="big"><span id="leaveTotalOut">4900.00</span></div>
        <div class="bigunit">ريال سعودي</div>
        <div class="breakdown">
          <div class="brow"><span>أجر اليوم الواحد</span><span id="leaveDailyOut">233.33 ريال</span></div>
          <div class="brow"><span>رصيد الإجازة النظامي</span><span id="leaveEntitleOut">21 يوماً</span></div>
        </div>
      </div>
    </div>
    <div class="legal"><h3>السند النظامي</h3>
      <div class="art">المادة (109): «للعامل الحق في إجازة سنوية لا تقل مدتها عن 21 يوماً، تصبح 30 يوماً إذا أمضى 5 سنوات متصلة لدى صاحب العمل نفسه، وتكون بأجر يُدفع مقدماً.»</div>
    </div>
  </section>

  <!-- ===== قرارات توطين المهن ===== -->
  <section class="panel" id="panel-professions">
    <h1 class="hero">قرارات توطين المهن</h1>
    <p class="lede">قرارات نوعية تستهدف مهناً محددة بنسبة توطين خاصة بها، منفصلة عن نظام نطاقات العام. قاعدة تتوسّع تدريجياً — كل قرار جديد يُضاف فور صدوره وتوثيقه.</p>

    <div class="deccard">
      <div class="top"><h3>توطين مهن التسويق والمبيعات</h3><span class="decpct">60%</span></div>
      <div class="chips">
        <span class="chip">مدير تسويق</span><span class="chip">أخصائي تسويق</span><span class="chip">مصمم جرافيك</span>
        <span class="chip">أخصائي علاقات عامة</span><span class="chip">مدير مبيعات</span><span class="chip">مندوب مبيعات</span>
        <span class="chip">أخصائي مبيعات</span><span class="chip">وسيط سلع</span>
      </div>
