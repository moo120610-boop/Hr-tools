  function calcEOS(){
    const wage = parseFloat(document.getElementById('eosWage').value) || 0;
    const y = parseFloat(document.getElementById('eosY').value) || 0;
    const m = parseFloat(document.getElementById('eosM').value) || 0;
    const d = parseFloat(document.getElementById('eosD').value) || 0;
    const years = y + (m/12) + (d/365);
    const type = document.getElementById('eosType').value;

    const first5 = Math.min(years,5);
    const rest = Math.max(years-5,0);
    const base = (first5*0.5*wage) + (rest*1*wage);

    let pct = 1, note = '';
    if(type==='resign'){
      if(years < 2){ pct = 0; note = 'أقل من سنتين خدمة: لا تستحق مكافأة عند الاستقالة وفق المادة (85).'; }
      else if(years < 5){ pct = 1/3; note = 'من سنتين إلى أقل من 5 سنوات: يستحق ثُلث المكافأة عند الاستقالة.'; }
      else if(years < 10){ pct = 2/3; note = 'من 5 إلى أقل من 10 سنوات: يستحق ثُلثي المكافأة عند الاستقالة.'; }
      else { pct = 1; note = '10 سنوات فأكثر: يستحق المكافأة كاملة رغم الاستقالة.'; }
    } else { pct = 1; note = 'إنهاء العقد من صاحب العمل أو انتهاء مدته: تُصرف المكافأة كاملة وفق المادة (84).'; }

    const total = base * pct;
    document.getElementById('eosYearsOut').textContent = years.toLocaleString('ar-SA',{maximumFractionDigits:2}) + ' سنة';
    document.getElementById('eosBaseOut').textContent = fmt(base) + ' ريال';
    document.getElementById('eosPctOut').textContent = (pct*100).toLocaleString('ar-SA',{maximumFractionDigits:1}) + '%';
    document.getElementById('eosTotalOut').textContent = fmt(total);
    const noteEl = document.getElementById('eosNote'); noteEl.style.display='block'; noteEl.textContent = note;
  }
